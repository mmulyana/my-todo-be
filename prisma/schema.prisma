generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        String   @id @default(uuid())
  title     String
  note      String   @default("")
  completed Boolean  @default(false)
  important Boolean  @default(false)
  today     String?
  dueDate   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Todo?   @relation("TodoSubtodos", fields: [parentId], references: [id], onDelete: Cascade)
  children Todo[]  @relation("TodoSubtodos")

  listId String?
  list   List?   @relation(fields: [listId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  attachments Attachment[]
}

model List {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  todos Todo[]
}

model Project {
  id          String   @id @default(uuid())
  code        String?  @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // note: null = top level project. Deleting a parent detaches its children instead of deleting them.
  parentId String?
  parent   Project?  @relation("ProjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Project[] @relation("ProjectTree")

  lists List[]
  todos Todo[]
  attachments Attachment[]
}

enum AttachmentType {
  IMAGE
  FILE
  LINK
}

model Attachment {
  id        String         @id @default(uuid())
  filename  String
  url       String
  mimeType  String?
  size      Int?
  type      AttachmentType @default(FILE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  todoId String?
  todo   Todo?   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
